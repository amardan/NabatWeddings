{
  "buildCommand": null,
  "outputDirectory": ".",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/packages/", "destination": "/collections/", "permanent": true },
    { "source": "/packages", "destination": "/collections/", "permanent": true },
    { "source": "/testimonials/", "destination": "/love-stories/", "permanent": true },
    { "source": "/testimonials", "destination": "/love-stories/", "permanent": true },
    { "source": "/reviews/", "destination": "/love-stories/", "permanent": true },
    { "source": "/reviews", "destination": "/love-stories/", "permanent": true }
  ]
}
